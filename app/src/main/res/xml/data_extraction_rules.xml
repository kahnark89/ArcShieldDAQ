<?xml version="1.0" encoding="utf-8"?>
<!--
    No cloud backup. API keys are stored in EncryptedSharedPreferences backed
    by the Android Keystore — they are non-transferable by design.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
